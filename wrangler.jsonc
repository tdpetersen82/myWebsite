{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "limestonegames",
  "compatibility_date": "2026-05-05",
  "main": "workers/api/casino/index.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "kv_namespaces": [
    {
      "binding": "LIMESTONE_KV",
      "id": "1da1bd544eda433fa4d77d45db0a9b3b"
    }
  ],
  // Journal photos are stored in LIMESTONE_KV above (journal:photo:{uuid}),
  // not R2 — R2 needs an account-level opt-in this account doesn't have, and a
  // downscaled photo is well under KV's 25MB per-value limit. If the library
  // ever outgrows KV's 1GB, move the photo routes to an R2 binding.
}
